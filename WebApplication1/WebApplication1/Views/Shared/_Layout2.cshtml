<!DOCTYPE html>
<html>
<head>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <title>Dashboard</title>
</head>
<body>
    <div class="row">
        <div class="col-lg-2-md-2 col-sm-2 col-xs-2" style="height:950px;background-color:cadetblue">


            <div class="list-group">



                <div class="list-group-item"> 
                    @Html.ActionLink("Add Category", "Add_Category", new { @class = "list-group-item" })
                </div>

                <div class="list-group-item">
                    @Html.ActionLink("Add Questions", "Add_Ques", new { @class = "list-group-item" })
                </div>

                <div class="list-group-item">
                    @Html.ActionLink("Add Students", "students", new { @class = "list-group-item" })
                </div>

                @*<div class="list-group-item">
                    @Html.ActionLink("Reports", "Dashboard", new { @class = "list-group-item" })
                </div>*@
            </div><br />

            <div class="list-group">
                <div class="list-group-item">
                    @Html.ActionLink("Logout", "LogOut", new { @class = "list-group-item" })
                </div>
            </div>
            </div>
            <div class="col-lg-10-md-10 col-sm-10" style="height: 900px;">
                @RenderBody()
            </div>
        </div>
</body>
</html>
