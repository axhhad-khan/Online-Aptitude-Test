@model WebApplication1.Models.student

@{
    ViewBag.Title = "slogin";
}



@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
<div class="form-horizontal">
    <h4>Student Login</h4>
    @if (ViewBag.msg != null)
    {
        <div class="alert alert-danger">
            <strong>Error ! </strong> @ViewBag.msg
        </div>

    }
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        @*@Html.LabelFor(model => model.std_name, htmlAttributes: new { @class = "control-label col-md-2" })*@<h5>Student Name:</h5>
        <div class="col-md-10">
            @Html.EditorFor(model => model.std_name, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.std_name, "", new { @class = "text-danger" })
        </div>
    </div><br/>

    <div class="form-group">
        @*@Html.LabelFor(model => model.std_password, htmlAttributes: new { @class = "control-label col-md-2" })*@<h5>Student Password:</h5>
        <div class="col-md-10">
            @Html.PasswordFor(model => model.std_password, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.std_password, "", new { @class = "text-danger" })
        </div>
    </div>


    <br/>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Login" class="btn btn-dark btn-block" />
        </div>
    </div>
</div>
}

<br/>
@*<div>
    @Html.ActionLink("Register Here!", "sregister", new { @class = "btn btn-dark btn-block" })
</div>*@

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
